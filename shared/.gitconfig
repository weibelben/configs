[include]
	path = ~/.gitconfig.local
[alias]
        rev = "!f(){ BRANCH=\"$(git rev-parse --abbrev-ref HEAD)\"; git push -u origin \"$BRANCH\":user/$USER/\"$BRANCH\" --force; }; f"
        #rev = "!f(){ BRANCH=\"$(git rev-parse --abbrev-ref HEAD)\"; git push -u origin \"$BRANCH\":\"$BRANCH\" --force; }; f"
[alias]
        co = "checkout"
[alias]
        rb = "rebase -i main"
[core]
	editor = vim
[color]
	ui = auto
[init]
	defaultBranch = main
